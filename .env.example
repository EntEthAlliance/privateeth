# Sepolia RPC. The public endpoint works; a private Infura/Alchemy URL is faster and steadier.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of a Sepolia account with test ETH. Used only by `npm run setup` to deploy,
# approve the banks and fund them with gas. Never use a key that holds real funds.
DEPLOYER_KEY=0x...

# Optional
# MINT_BANK_A=1000
# MINT_BANK_B=500
# FUND_ETH=0.05

# Where the site lives (the links point here). Default: the GitHub Pages site.
# SITE_URL=https://hub.entethalliance.org/privateeth/
# RPC the browsers use, if different from RPC_URL (for example a public endpoint
# instead of a private one with an API key in it).
# WEB_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
